// The install plane Worker. Deploy is a separate step: see README.md.
{
  "name": "blunix-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "api.blunix.io/*", "zone_name": "blunix.io" },
    { "pattern": "*.blnx.io/*", "zone_name": "blnx.io" },
    { "pattern": "blnx.io/*", "zone_name": "blnx.io" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blunix-install-plane",
      // Set from `wrangler d1 create blunix-install-plane`.
      "database_id": "cc4d259d-8a8c-42fc-9839-15c74c059df0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUILDS", "bucket_name": "blunix-builds" }],
  "vars": {
    // Empty means sign-in answers 503 until the Authentik app exists.
    "OIDC_ISSUER": "https://adsas.id/application/o/blunix-build/",
    "OIDC_CLIENT_ID": "blunix-build",
    "PORTAL_ORIGIN": "https://build.blunix.io",
    // Extra CORS and CSRF origins for wrangler dev, such as http://localhost:8765. Empty in production.
    "DEV_ORIGINS": "",
    // "on" once v{n}.{label}.blnx.io has certificates. Until then the API returns pinnedUrl: null.
    "PINNED_HOSTS_TLS": ""
  }
  // Secret, never in the tree: OIDC_CLIENT_SECRET (wrangler secret put OIDC_CLIENT_SECRET).
}
